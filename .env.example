# Copie para .env e ajuste. O docker compose lê estas variáveis sozinho.
# .env está no .gitignore — nenhum valor seu vai parar no GitHub.
# No Dokploy, preencha o mesmo nome no painel Environment.

# ============ servidor ============
PORTA=8000
HOST=0.0.0.0
ARQ_LOG=/dados/capturas.jsonl
# Caminho do HTML da fachada (no container: /app/mascara.html).
MASCARA=/app/mascara.html

# Senha do /painel. Se ficar vazio, o app sorteia um token novo a cada boot
# (e você precisa olhar o log do container para descobrir a URL).
TOKEN_PAINEL=troque-este-token

# Domínio público, só para aparecer no log de inicialização.
URL_PUBLICA=https://contatos.exemplo.com

# 1 = mantém o selo "demonstração de aula" na fachada (padrão)
# 0 = remove o selo
DIVULGAR=1

# Destino do redirect da rota /r (opcional)
DESTINO=https://example.com

# ============ fachada: empresa ============
EMPRESA_NOME=PsiWare
EMPRESA_RAMO=Software de segurança e monitoramento
EMPRESA_BIO=Canais oficiais de atendimento da matriz.
EMPRESA_CNPJ=58.761.840/0001-00
EMPRESA_ENDERECO=Av. Antonio Sílvio Barbierri, 2346 Francisco Beltrão - PR, 85503-000
EMPRESA_HORARIO=Segunda a sexta, das 8h às 17h

# ============ fachada: contatos ============
# Use números INEXISTENTES. Fixo brasileiro começa com 2, 3, 4 ou 5 —
# então (11) 0000-xxxx não existe. É a pista falsa da aula.
CONTATO1_NOME=Kelly Moreira
CONTATO1_CARGO=Secretaria
CONTATO1_NUMERO=(11) 0000-0000

CONTATO2_NOME=Recursos Humanos
CONTATO2_CARGO=RH
CONTATO2_NUMERO=(11) 0000-0001

CONTATO3_NOME=Contábil
CONTATO3_CARGO=Financeiro
CONTATO3_NUMERO=(11) 0000-0002
